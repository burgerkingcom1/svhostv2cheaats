local function ToggleGUI()
    DebugPrint("ToggleGUI called")
    
    if not mainGui then
        DebugPrint("mainGui is nil! Attempting to recreate...")
        SetupGUI()
        if not mainGui then
            DebugPrint("Failed to create GUI!")
            return
        end
    end
    
    local frame = mainGui:FindFirstChild("MainFrame")
    if not frame then
        DebugPrint("MainFrame not found in mainGui!")
        return
    end
    
    if guiTween and guiTween.PlaybackState == Enum.PlaybackState.Playing then
        guiTween:Cancel()
    end
    
    guiVisible = not guiVisible
    DebugPrint("GUI visible: " .. tostring(guiVisible))
    
    local targetProperties = {}
    local tweenInfo = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    
    if guiVisible then
        targetProperties = {
            BackgroundTransparency = 0.12,
            Size = UDim2.new(0, 340, 0, 460)
        }
        for _, child in ipairs(frame:GetChildren()) do
            if child:IsA("GuiObject") and child ~= frame then
                pcall(function()
                    local childTween = TweenService:Create(child, tweenInfo, {
                        BackgroundTransparency = 0,
                        TextTransparency = 0,
                        ImageTransparency = 0
                    })
                    childTween:Play()
                end)
            end
        end
        if fovCircle then
            pcall(function()
                fovCircle.ImageTransparency = 0.55
                fovCircle.Visible = true
            end)
        end
    else
        targetProperties = {
            BackgroundTransparency = 0.9,
            Size = UDim2.new(0, 50, 0, 50)
        }
        for _, child in ipairs(frame:GetChildren()) do
            if child:IsA("GuiObject") and child ~= frame then
                pcall(function()
                    local childTween = TweenService:Create(child, tweenInfo, {
                        BackgroundTransparency = 1,
                        TextTransparency = 1,
                        ImageTransparency = 1
                    })
                    childTween:Play()
                end)
            end
        end
        if fovCircle then
            pcall(function()
                fovCircle.ImageTransparency = 1
                fovCircle.Visible = false
            end)
        end
    end
    
    guiTween = TweenService:Create(frame, tweenInfo, targetProperties)
    guiTween:Play()
end

