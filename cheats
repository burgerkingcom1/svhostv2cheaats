-- МОДУЛЬ 5: TOGGLE GUI ПО КЛАВИШЕ J С АНИМАЦИЕЙ
-- =====================================================================
local function ToggleGUI()
    if not mainGui then return end
    
    -- Находим основной фрейм внутри GUI
    local frame = mainGui:FindFirstChild("MainFrame")
    if not frame then return end
    
    -- Отменяем предыдущую анимацию, если она ещё идёт
    if guiTween and guiTween.PlaybackState == Enum.PlaybackState.Playing then
        guiTween:Cancel()
    end
    
    -- Переключаем состояние
    guiVisible = not guiVisible
    
    -- Целевые параметры анимации
    local targetProperties = {}
    local tweenInfo = TweenInfo.new(
        0.35,                              -- длительность в секундах
        Enum.EasingStyle.Quad,             -- стиль плавности
        Enum.EasingDirection.Out,          -- направление
        0,                                 -- повторений
        false,                             -- реверс
        0                                  -- задержка
    )
    
    if guiVisible then
        -- Анимация открытия: масштаб от 0.5 к 1.0 + прозрачность от 0.4 к 1.0
        targetProperties = {
            BackgroundTransparency = 0.12,
            Size = UDim2.new(0, 340, 0, 460)
        }
        -- Также анимируем все дочерние элементы (для эффекта "выезда")
        for _, child in ipairs(frame:GetChildren()) do
            if child:IsA("GuiObject") and child ~= frame then
                local childTween = TweenService:Create(child, tweenInfo, {
                    BackgroundTransparency = child.BackgroundTransparency > 0.5 and child.BackgroundTransparency or 0,
                    Position = child.Position + UDim2.new(0, 0, 0, 0) -- сброс
                })
                childTween:Play()
            end
        end
    else
        -- Анимация закрытия: сжатие к центру + исчезновение
        targetProperties = {
            BackgroundTransparency = 0.9,
            Size = UDim2.new(0, 50, 0, 50)
        }
        -- Дочерние элементы делаем прозрачными
        for _, child in ipairs(frame:GetChildren()) do
            if child:IsA("GuiObject") and child ~= frame then
                local childTween = TweenService:Create(child, tweenInfo, {
                    BackgroundTransparency = 1,
                    TextTransparency = 1,
                    ImageTransparency = 1
                })
                childTween:Play()
            end
        end
    end
    
    -- Анимируем сам фрейм
    guiTween = TweenService:Create(frame, tweenInfo, targetProperties)
    guiTween:Play()
    
    -- Дополнительно: показываем/скрываем FOV круг вместе с GUI
    if fovCircle then
        local fovTween = TweenService:Create(fovCircle, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            ImageTransparency = guiVisible and 0.55 or 1
        })
        fovTween:Play()
    end
end

