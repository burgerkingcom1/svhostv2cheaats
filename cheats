-- [5] СКОРОСТНОЙ CFrame
-- =====================================================================
local function SpeedCFrame()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
    if not root then return end
    
    local forward = Camera.CFrame.LookVector * Vector3.new(1, 0, 1)
    if forward.Magnitude < 0.001 then return end
    forward = forward.Unit
    
    local newPos = root.Position + forward * Config.Speed
    root.CFrame = CFrame.new(newPos) * CFrame.Angles(0, math.rad(root.Orientation.Y), 0)
end

-- =====================================================================
-- [6] ПОИСК ЦЕЛИ
-- =====================================================================
local function GetTarget()
    local char = LocalPlayer.Character
    if not char then return nil end
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end
    
    local viewportSize = Camera.ViewportSize
    local centerX, centerY = viewportSize.X / 2, viewportSize.Y / 2
    
    local bestTarget = nil
    local bestDist = math.huge
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if Config.TeamCheck and player.Team == LocalPlayer.Team then continue end
        
        local targetChar = player.Character
        if not targetChar then continue end
        
        local targetPart = targetChar:FindFirstChild(Config.AimPart)
        if not targetPart then 
            targetPart = targetChar:FindFirstChild("HumanoidRootPart")
            if not targetPart then continue end
        end
        
        local screenPoint, onScreen = Camera:WorldToScreenPoint(targetPart.Position)
        if not onScreen then continue end
        
        local dx = screenPoint.X - centerX
        local dy = screenPoint.Y - centerY
        local dist = math.sqrt(dx*dx + dy*dy)
        
        if dist <= Config.AimFOV and dist < bestDist then
            bestDist = dist
            bestTarget = {
                Player = player,
                Part = targetPart,
                ScreenPos = Vector2.new(screenPoint.X, screenPoint.Y),
                Distance = dist
            }
        end
    end
    
    return bestTarget
end

-- =====================================================================
-- [7] SILENT AIM
-- =====================================================================
local function SilentAimStep()
    if not Config.SilentAimEnabled then return end
    if not isAiming then 
        aimTarget = nil 
        return 
    end
    
    local targetData = GetTarget()
    if not targetData then
        aimTarget = nil
        return
    end
    
    aimTarget = targetData.Part
    
    local currentCF = Camera.CFrame
    local targetPos = aimTarget.Position
    local lookAtCF = CFrame.lookAt(currentCF.Position, targetPos)
    local newCF = currentCF:Lerp(lookAtCF, Config.AimSpeed)
    Camera.CFrame = newCF
end

