--  ФИКС КУРСОРА (исправлено: Library.Open не существует)
-- ═══════════════════════════════════════════════════════════════

pcall(function()
    UserInputService.MouseIconEnabled = true
    UserInputService.MouseBehavior = Enum.MouseBehavior.Default
end)

-- Держим системный курсор включённым всегда, когда меню открыто.
-- Window.Holder — это Outer-фрейм окна (Visible = true когда меню открыто).
task.spawn(function()
    while task.wait(0.05) do
        local menuOpen = false
        pcall(function()
            if Window and Window.Holder then
                menuOpen = Window.Holder.Visible
            end
        end)
        if menuOpen then
            pcall(function()
                UserInputService.MouseIconEnabled = true
                UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            end)
        end
    end
end)

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        task.wait(0.05)
        for i = 1, 10 do
            pcall(function()
                UserInputService.MouseIconEnabled = true
                UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            end)
            task.wait(0.01)
        end
    end
end)

Library:OnUnload(function()
    pcall(function()
        UserInputService.MouseIconEnabled = true
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    end)
end)
