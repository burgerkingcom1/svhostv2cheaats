local function safeCall(func, ...)
    local success, err = pcall(func, ...)
    if not success then
        warn("[KUSMAN ERROR]: " .. tostring(err))
    end
    return success
end

local origGetTarget = GetTarget
GetTarget = function(...) return safeCall(origGetTarget, ...) end

local origSilent = SilentAimStep
